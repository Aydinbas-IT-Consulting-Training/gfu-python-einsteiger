<mxfile host="drawio">
  <diagram id="fstring-format" name="f-String-Format">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="code" value="price = 1234.5678&lt;br&gt;f&quot;Preis: {price:,.2f} €&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- Platzhalter zerlegt -->
        <mxCell id="ob" value="{" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_name" value="price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_colon" value=":" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=22;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="170" y="80" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_comma" value="," style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_prec" value=".2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_f" value="f" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cb" value="}" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="40" height="50" as="geometry" />
        </mxCell>
        <!-- Erklärungen, rechts gestaffelt -->
        <mxCell id="l_f" value="als Kommazahl" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="145" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l_prec" value="2 Nachkommastellen, gerundet" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="185" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l_comma" value="Tausendertrennzeichen (US-Format)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="225" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l_colon" value="ab hier steht das Format" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="265" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l_name" value="dieser Wert wird eingesetzt" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="305" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e_f" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_f" target="l_f">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_prec" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_prec" target="l_prec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_comma" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_comma" target="l_comma">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_colon" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_colon" target="l_colon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_name" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_name" target="l_name">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Ergebnis -->
        <mxCell id="res_l" value="Ergebnis:" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="0" y="360" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="res" value="Preis: 1,234.57 €" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=22;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="260" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
