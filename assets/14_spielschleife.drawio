<mxfile host="drawio">
  <diagram id="spielschleife" name="Spielschleife (Plan)">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Knoten: Plan in Worten, kein Code (Übung 5 schreibt play() selbst) -->
        <mxCell id="start" value="Spiel startet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="150" y="0" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="leeres Spielfeld anlegen,&lt;br&gt;X beginnt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="74" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Spielfeld anzeigen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="168" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Feld abfragen und&lt;br&gt;Zeichen setzen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="242" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Meldung ausgeben" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="510" y="249" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="gewonnen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="105" y="336" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="win" value="Spielfeld anzeigen,&lt;br&gt;Sieger melden" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="465" y="353" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Spielfeld voll?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="105" y="480" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="draw" value="Spielfeld anzeigen,&lt;br&gt;Unentschieden melden" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="465" y="497" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Spieler wechseln" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="610" width="240" height="44" as="geometry" />
