<mxfile host="drawio">
  <diagram id="variablen-namen" name="Namen und Werte">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Kopfzeile -->
        <mxCell id="h_names" value="Namen" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_values" value="Werte" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="130" height="30" as="geometry" />
        </mxCell>
        <!-- age -->
        <mxCell id="n_age" value="age" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="0" y="40" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_age" value="18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_age" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="n_age" target="v_age">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- the_answer: vorher 41, jetzt 42 -->
        <mxCell id="n_ans" value="the_answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="0" y="130" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_41" value="41" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_42" value="42" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_41" value="vorher" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=14;fontFamily=Helvetica;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_ans" target="v_41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_42" value="jetzt" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_ans" target="v_42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_ans" value="the_answer = 42&lt;br&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 16px;&quot; color=&quot;#333333&quot;&gt;lenkt den Namen auf einen neuen Wert um&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="125" width="340" height="50" as="geometry" />
        </mxCell>
        <!-- simple_pi -->
        <mxCell id="n_pi" value="simple_pi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="0" y="230" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_pi" value="3.1415" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_pi" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="n_pi" target="v_pi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- name -->
        <mxCell id="n_name" value="name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="0" y="290" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_name" value="&quot;Michael&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_name" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="n_name" target="v_name">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- is_valid -->
        <mxCell id="n_valid" value="is_valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="0" y="350" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_valid" value="True" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_valid" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="n_valid" target="v_valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
