<mxfile host="drawio">
  <diagram id="while-schleife" name="while-Schleife">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="0" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init" value="balance = 1000.0&lt;br&gt;years = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;align=left;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="90" y="70" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cond" value="balance &lt; 2000" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="body" value="balance *= 1.05&lt;br&gt;years += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;align=left;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="print(f&quot;Nach {years} Jahren …&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Ende" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="480" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="start" target="init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="init" target="cond">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="etrue" value="True" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cond" target="body">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eback" value="erneut prüfen" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="body" target="cond">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="330" />
              <mxPoint x="20" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="efalse" value="False" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cond" target="out">
          <mxGeometry x="-0.7" relative="1" as="geometry">
