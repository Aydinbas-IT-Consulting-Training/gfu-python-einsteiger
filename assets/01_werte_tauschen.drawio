        <mxCell id="c2" value="," style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="475" y="50" width="25" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_first" value="first_name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="140" height="40" as="geometry" />
        </mxCell>
        <!-- Schritt 1: rechte Seite auswerten -->
        <mxCell id="v_stefan" value="&quot;Stefan&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="355" y="150" width="110" height="40" as="geometry" />
