        <mxCell id="before" value="vorher: first_name, last_name = &quot;Huber&quot;, &quot;Stefan&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
