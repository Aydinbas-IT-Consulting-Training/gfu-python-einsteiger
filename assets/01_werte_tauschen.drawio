        <mxCell id="v_huber" value="&quot;Huber&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="515" y="150" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1a" value="1." style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;fontSize=16;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r_last" target="v_stefan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1b" value="1." style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;fontSize=16;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r_first" target="v_huber">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Schritt 2: der Reihe nach verteilen -->
        <mxCell id="s2a" value="2." style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=16;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v_stefan" target="l_first">
