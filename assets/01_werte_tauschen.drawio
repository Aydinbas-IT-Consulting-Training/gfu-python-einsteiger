        <mxCell id="l_last" value="last_name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="165" y="50" width="130" height="40" as="geometry" />
