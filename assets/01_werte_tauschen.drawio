        <mxCell id="s2b" value="2." style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=16;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v_huber" target="l_last">
