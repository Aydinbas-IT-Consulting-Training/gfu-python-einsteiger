        <!-- Erklärung und Ergebnis -->
        <mxCell id="t1" value="1. Python wertet zuerst die ganze rechte Seite aus." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
