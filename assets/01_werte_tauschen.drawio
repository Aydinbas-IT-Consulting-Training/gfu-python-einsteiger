        <mxCell id="after" value="nachher: first_name → &quot;Stefan&quot;, last_name → &quot;Huber&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
