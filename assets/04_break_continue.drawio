<mxfile host="drawio">
  <diagram id="break-continue" name="break und continue">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- break -->
        <mxCell id="f1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="780" height="250" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="tries = 0" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="15" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="while True:" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="45" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="roll = random.randint(1, 6)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="123" y="75" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="tries += 1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="123" y="105" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="if roll == 6:" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="123" y="135" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="break" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="166" y="165" width="76" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="print(f&quot;Nach {tries} Würfen eine 6&quot;)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="205" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bnote" value="&lt;b&gt;break&lt;/b&gt;: Schleife sofort verlassen,&lt;br&gt;weiter hinter der Schleife" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="530" y="150" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bjump" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="180" />
              <mxPoint x="40" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- continue -->
        <mxCell id="f2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="280" width="780" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c0" value="for number in range(1, 11):" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="295" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="if number % 3 == 0:" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="123" y="325" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="continue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="166" y="355" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="print(number, end=&quot; &quot;)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="123" y="385" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cout" value="Ausgabe: &lt;font face=&quot;Menlo&quot; style=&quot;font-size:18px&quot;&gt;1 2 4 5 7 8 10&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="428" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cnote" value="&lt;b&gt;continue&lt;/b&gt;: Rest überspringen,&lt;br&gt;weiter mit der nächsten Zahl" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="530" y="340" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cjump" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="370" />
              <mxPoint x="40" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
