<mxfile host="drawio">
  <diagram id="funktionsaufruf" name="Funktionsaufruf">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="call" value="price = gross_price(100, 0.19)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="callnote" value="1. Aufruf: Python springt in die Funktion" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="430" y="0" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="100" width="800" height="230" as="geometry" />
        </mxCell>
        <mxCell id="def" value="def gross_price(net_price, vat_rate):" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="440" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pnet" value="net_price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v100" value="100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="260" y="160" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pvat" value="vat_rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v019" value="0.19" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="260" y="215" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="pnet" target="v100">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="pvat" target="v019">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="paramnote" value="2. Die Parameter sind lokale Namen&lt;br&gt;für die Argumente 100 und 0.19" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="return net_price * (1 + vat_rate)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="275" width="380" height="36" as="geometry" />
        </mxCell>
        <mxCell id="res" value="119.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="520" y="273" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;strokeColor=#333333;" edge="1" parent="1" source="ret" target="res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ein" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="42" as="sourcePoint" />
            <mxPoint x="280" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="einlabel" value="Argumente" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="55" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="price" value="price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="320" y="390" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="res2" value="119.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="520" y="390" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="price" target="res2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eout" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="res" target="res2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="outlabel" value="Rückgabewert" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="575" y="342" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="backnote" value="3. Zurück beim Aufrufer:&lt;br&gt;price bekommt das Ergebnis" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="0" y="380" width="300" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
