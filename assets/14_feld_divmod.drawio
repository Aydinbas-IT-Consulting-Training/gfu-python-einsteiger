<mxfile host="drawio">
  <diagram id="feld-divmod" name="Feld und divmod">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Spaltenkoepfe -->
        <mxCell id="col0" value="col = 0" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="10" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="col1" value="col = 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="210" y="10" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="col2" value="col = 2" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="90" height="30" as="geometry" />
        </mxCell>
        <!-- Zeilenkoepfe -->
        <mxCell id="row0" value="row = 0" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="row1" value="row = 1" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="row2" value="row = 2" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontFamily=Menlo;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="230" width="90" height="90" as="geometry" />
        </mxCell>
        <!-- Felder: gross die Feldnummer, klein (row, col) -->
        <mxCell id="f1" value="&lt;span style=&quot;font-size:26px&quot;&gt;1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(0, 0)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="120" y="50" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;span style=&quot;font-size:26px&quot;&gt;2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(0, 1)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="210" y="50" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;span style=&quot;font-size:26px&quot;&gt;3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(0, 2)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;span style=&quot;font-size:26px&quot;&gt;4&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(1, 0)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="120" y="140" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;span style=&quot;font-size:26px&quot;&gt;5&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(1, 1)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="210" y="140" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;span style=&quot;font-size:26px&quot;&gt;6&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(1, 2)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="&lt;span style=&quot;font-size:26px&quot;&gt;7&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(2, 0)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="120" y="230" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="&lt;span style=&quot;font-size:26px&quot;&gt;8&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(2, 1)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="210" y="230" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="&lt;span style=&quot;font-size:26px&quot;&gt;9&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;(2, 2)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="groß: Feldnummer &lt;font face=&quot;Menlo&quot;&gt;field&lt;/font&gt; (Eingabe)&lt;br&gt;klein: &lt;font face=&quot;Menlo&quot;&gt;(row, col)&lt;/font&gt; in der Liste &lt;font face=&quot;Menlo&quot;&gt;board&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="320" height="50" as="geometry" />
        </mxCell>
        <!-- Rechnung -->
        <mxCell id="code" value="row, col = divmod(field - 1, 3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="450" y="50" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ex" value="Beispiel &lt;font face=&quot;Menlo&quot;&gt;field = 6&lt;/font&gt;:" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="95" width="350" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ex1" value="divmod(6 - 1, 3) → (1, 2)&lt;br&gt;5 // 3 = 1 &lt;font face=&quot;Helvetica&quot; color=&quot;#333333&quot;&gt;→ Zeile&lt;/font&gt;&lt;br&gt;5 % 3&amp;nbsp; = 2 &lt;font face=&quot;Helvetica&quot; color=&quot;#333333&quot;&gt;→ Spalte&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontFamily=Menlo;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="450" y="125" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="target" value="board[1][2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Menlo;" vertex="1" parent="1">
          <mxGeometry x="450" y="225" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="aTarget" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="245" as="sourcePoint" />
            <mxPoint x="392" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
