<mxfile host="drawio">
  <diagram id="try-except-ablauf" name="try-except-Ablauf">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="&lt;font face=&quot;Menlo&quot; style=&quot;font-size:18px&quot;&gt;parse_number(text)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="0" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="try" value="try:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;number = float(text)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="225" y="80" width="330" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cond" value="ValueError&lt;br&gt;ausgelöst?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="exabc" value="z. B. &lt;font face=&quot;Menlo&quot; style=&quot;font-size:18px&quot;&gt;text = &quot;abc&quot;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="0" y="190" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ex35" value="z. B. &lt;font face=&quot;Menlo&quot; style=&quot;font-size:18px&quot;&gt;text = &quot;3.5&quot;&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="550" y="190" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="exc" value="except ValueError:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;print(f&quot;'{text}' ist ungültig&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontFamily=Menlo;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="0" y="330" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="els" value="else:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;print(f&quot;'{text}' gelesen&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return number" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontFamily=Menlo;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fin" value="finally:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;print(&quot;Prüfung beendet&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=Menlo;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="finnote" value="läuft immer" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end" value="zurück zum Aufrufer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="570" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="start" target="try">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="try" target="cond">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="etrue" value="True" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cond" target="exc">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="efalse" value="False" style="endArrow=classic;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=15;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cond" target="els">
          <mxGeometry x="0.2" relative="1" as="geometry">
